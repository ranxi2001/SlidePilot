# LLM Provider Configuration
# SlidePilot supports any OpenAI-compatible API (OpenAI, DeepSeek, Ollama, vLLM, etc.)

# Required: API base URL
LLM_BASE_URL=https://api.openai.com/v1

# Required: API key
LLM_API_KEY=sk-your-key-here

# Required: Model name
LLM_MODEL=gpt-4o

# Optional: Max tokens per request (default: 4096)
# LLM_MAX_TOKENS=4096

# Optional: Temperature (default: 0.7)
# LLM_TEMPERATURE=0.7

# Optional: Server port (default: 4321)
# PORT=4321
