# LLM Provider Configuration
# SlidePilot supports any OpenAI-compatible API (OpenAI, DeepSeek, Ollama, vLLM, etc.)

# Required: API base URL
LLM_BASE_URL=https://api.openai.com/v1

# Required: API key
LLM_API_KEY=sk-your-key-here

# Required: Model name
LLM_MODEL=gpt-4o

# Optional: Max tokens per request (default: 4096)
# LLM_MAX_TOKENS=4096

# Optional: Temperature (default: 0.7)
# LLM_TEMPERATURE=0.7

# Optional: image generation/editing tool.
# Defaults to LLM_BASE_URL/LLM_API_KEY when IMAGE_* is not set.
# IMAGE_BASE_URL=https://api.openai.com/v1
# IMAGE_API_KEY=sk-your-key-here
# IMAGE_MODEL=gpt-image-2
# IMAGE_AUTO_GENERATE=true
# IMAGE_MAX_IMAGES_PER_RUN=8

# Optional: Server port (default: 4321)
# PORT=4321
